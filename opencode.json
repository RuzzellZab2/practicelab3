{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp"],
      "enabled": true,
      "environment": {
        "PLAYWRIGHT_MCP_BROWSER": "chromium",
        "PLAYWRIGHT_MCP_HEADLESS": "1",
        "PLAYWRIGHT_MCP_EXECUTABLE_PATH": "/home/rus/.cache/ms-playwright/chromium-1212/chrome-linux64/chrome",
        "PLAYWRIGHT_MCP_NO_SANDBOX": "1"
      }
    }
  },
  "permission": {
    "playwright_*": "allow"
  }
}
